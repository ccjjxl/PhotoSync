<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The gradient spans the 72dp visible area (18..90), not the full 108dp
         bleed, so the adaptive icon matches assets/app-icon-1024.png. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#5CB4EC" />
                <item android:offset="0.52" android:color="#3D8BE6" />
                <item android:offset="1" android:color="#2F6BD8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft highlight from the top-left, same as the SVG master. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38.16"
                android:centerY="32.4"
                android:gradientRadius="54">
                <item android:offset="0" android:color="#29FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
